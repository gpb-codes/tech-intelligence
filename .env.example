# ============================================================
# Tech Intelligence — variables de entorno
# Copiar a .env y ajustar. NUNCA versionar .env.
# ============================================================

# Backend de IA: ollama (local) | openrouter (cloud, con web search si el modelo es :online)
AI_BACKEND=ollama

# Ollama (para Docker usar http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# OpenRouter (solo si AI_BACKEND=openrouter)
# Modelo :online hace búsqueda web real para el informe profesional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2:online

# Rutas (en Docker: /app/vault y /app/database)
VAULT_PATH=./vault
DATABASE_PATH=./database/tech_intelligence.db

# Scheduler (minutos entre ciclos completos)
SYNC_INTERVAL=60

# Logs
LOG_LEVEL=INFO

# GitHub API (opcional, para límites de rate más altos)
GITHUB_TOKEN=

# Control de procesamiento
MAX_PROCESSING_ATTEMPTS=3